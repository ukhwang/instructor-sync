{
  "name": "instructor-sync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:p0": "node --test tests/p0-contract.test.mjs tests/p0-secrets.test.mjs",
    "test:p0:legacy": "node --test contracts/legacy-p0.mjs",
    "test:p0:bundle": "node --test contracts/bundle-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "verify": "node --test && tsc --noEmit && eslint",
    "test:e2e": "playwright test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:migrate": "wrangler d1 migrations apply instructor-sync --local",
    "cf:migrate:remote": "wrangler d1 migrations apply instructor-sync --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "cf:typecheck": "npm run cf:typegen && tsc --noEmit",
    "cf:invite": "node scripts/cf/invite-trainer.mjs",
    "cf:set-plan": "node scripts/cf/set-trainer-plan.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@tanstack/react-query": "^5.96.2",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.4.7",
    "next": "^16.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@electric-sql/pglite": "0.5.8",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.165.0"
  }
}
