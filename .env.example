# Cloudflare Workers + D1 deployment.
# Secrets are NOT read from .env files at runtime:
#   - local:      copy .dev.vars.example → .dev.vars (gitignored)
#   - production: wrangler secret put BETTER_AUTH_SECRET / BETTER_AUTH_URL
# Bindings (D1 `DB`) and public vars live in wrangler.jsonc.
NEXT_PUBLIC_APP_URL=http://localhost:8787

# Optional, local only (never true in production builds): enables lib/demo-mode helpers.
# NEXT_PUBLIC_DEMO_MODE=true
