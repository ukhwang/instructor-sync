{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deployment for the Next.js app (built by @opennextjs/cloudflare).
  // Account-level resources (D1 database id, secrets) are NOT created by this repo.
  // See docs/CLOUDFLARE_MIGRATION.md for the operator runbook.
  "name": "instructor-sync",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by OpenNext for internal revalidation/caching.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "instructor-sync"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instructor-sync",
      // Placeholder. Replace with the id printed by `wrangler d1 create instructor-sync`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://instructor-sync.example.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Audit NV-3: automatic per-request invocation logs record the request URL,
      // which for /h/<token> and /report/<token> is a capability. Disabled; the app
      // logs only operation names and error codes, never tokens or payloads.
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
